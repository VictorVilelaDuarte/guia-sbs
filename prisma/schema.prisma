generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  COMERCIANTE
}

// PlanType enum removido — substituído pelo model Plan

// Papel de um usuário dentro de um comércio (ComercioMembro). As permissões de
// cada papel vivem em código (src/lib/gestao/permissoes.ts), não no banco —
// ver docs/modulo-gestao.md (Fase 1).
enum PapelMembro {
  DONO // tudo, inclusive equipe
  GERENTE // tudo operacional + vendas, sem equipe
  ATENDENTE // pedidos e disponibilidade do cardápio
  PRODUCAO // só a fila de pedidos (cozinha/preparo)
}

enum ComercioStatus {
  PENDENTE
  ATIVO
  INATIVO
  REJEITADO
}

enum Categoria {
  ALIMENTACAO
  HOSPEDAGEM
  TURISMO
  SERVICO
  COMERCIO
  ENTRETENIMENTO
}

enum TipoProduto {
  PRODUTO
  SERVICO
}

enum CategoriaPonto {
  MIRANTE
  TRILHA
  HISTORICO
  CACHOEIRA
}

enum Dificuldade {
  FACIL
  MODERADA
  DIFICIL
}

// Status de um pedido online. Transições válidas vivem em src/lib/pedidos.ts
// (TRANSICOES / podeTransicionar) — não deixar o status virar campo livre.
enum PedidoStatus {
  AGUARDANDO // recém-criado, comerciante ainda não agiu
  ACEITO // confirmado pela loja
  EM_PREPARO
  PRONTO // retirada: pronto p/ buscar | entrega: pronto p/ sair
  SAIU_ENTREGA // só entrega
  CONCLUIDO // entregue / retirado (terminal)
  RECUSADO // loja recusou (terminal)
  CANCELADO // cliente ou loja cancelou (terminal)
  ABERTA // comanda de mesa/nome no PDV: recebe itens e pagamentos até fechar
}

// Por onde a venda entrou (Fase 3). ONLINE = checkout do cardápio; BALCAO e
// TELEFONE = venda manual registrada no PDV; COMANDA = conta de mesa/nome no PDV.
enum OrigemPedido {
  ONLINE
  BALCAO
  TELEFONE
  COMANDA
}

// Quem causou uma mudança de status do pedido (PedidoHistorico).
enum OrigemHistorico {
  CLIENTE // checkout ou cancelamento pelo /pedido/[token]
  LOJA // membro da equipe no painel
  ADMIN // admin do guia pelo "gerenciar"
}

// Chamado feito pelo cliente na página da mesa (QR Code).
enum TipoChamado {
  GARCOM // "preciso de atendimento"
  CONTA // "quero fechar a conta"
}

enum TipoEntrega {
  ENTREGA
  RETIRADA
}

model Plan {
  id        String   @id @default(cuid())
  slug      String   @unique
  nome      String
  descricao String?
  preco     Float    @default(0)
  features  Json     @default("{}")
  ativo     Boolean  @default(true)
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comercios Comercio[]

  @@map("plans")
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  role        Role     @default(COMERCIANTE)
  active      Boolean  @default(true)
  // Senha temporária gerada pela tela de equipe: o painel e as APIs ficam
  // bloqueados até o usuário trocar (/comerciante/trocar-senha).
  trocarSenha Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Comércios em que o usuário é o titular cadastrado pelo admin. Acesso ao
  // painel NÃO vem daqui — vem de `membros` (ComercioMembro).
  comerciosTitular Comercio[]
  membros          ComercioMembro[]
  sessions         Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Comercio {
  id         String         @id @default(cuid())
  slug       String         @unique
  nome       String
  descricao  String?        @db.Text
  categorias Categoria[]
  status     ComercioStatus @default(PENDENTE)
  planId     String
  cep        String?
  endereco   String?
  numero     String?
  bairro     String?
  cidade     String?
  estado     String?
  lat        Float?
  lng        Float?
  telefone   String?
  whatsapp   String?
  email      String?
  website    String?
  instagram  String?
  horarios   String?
  logo       String?
  // Titular (responsável cadastrado pelo admin). Não é único: um usuário pode
  // ser titular de várias lojas. Acesso ao painel é decidido por ComercioMembro.
  ownerId    String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  plan                Plan                 @relation(fields: [planId], references: [id])
  tags                Tag[]
  fotos               Foto[]
  eventos             Evento[]
  produtos            Produto[]
  cardapioCategorias  CardapioCategoria[]
  catalogoCategorias  CatalogoCategoria[]
  subcategorias       Subcategoria[]
  analyticsEvents     AnalyticsEvent[]
  hospedagemPerfil    HospedagemPerfil?
  tiposQuarto         TipoQuarto[]
  pedidos             Pedido[]
  pedidoConfig        PedidoConfig?
  pushSubscriptions   PushSubscription[]
  zonasEntrega        ZonaEntrega[]
  membros             ComercioMembro[]
  clientes            Cliente[]
  mesas               Mesa[]
  chamadosMesa        ChamadoMesa[]
  acessosDadosCliente AcessoDadosCliente[]

  @@index([ownerId])
  @@map("comercios")
}

// Vínculo usuário ↔ comércio com papel. É a fonte de verdade de acesso ao painel
// (getComercioCtx). Todo comércio tem ao menos um DONO — criado junto com o
// comércio (POST /api/admin/comercios) e, para os antigos, por
// prisma/migrate-membros-dono.ts. `ativo: false` corta o acesso sem apagar.
model ComercioMembro {
  id         String      @id @default(cuid())
  comercioId String
  userId     String
  papel      PapelMembro
  ativo      Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  comercio Comercio @relation(fields: [comercioId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([comercioId, userId])
  @@index([userId])
  @@map("comercio_membros")
}

// Perfil de hospedagem (1:1 com Comercio) — criado sob demanda só para
// negócios de categoria HOSPEDAGEM. Guarda comodidades (chaves do catálogo
// em src/lib/hospedagem.ts) e políticas da casa. Quartos ficam em TipoQuarto.
model HospedagemPerfil {
  id                   String   @id @default(cuid())
  comercioId           String   @unique
  comodidades          String[]
  checkIn              String?
  checkOut             String?
  politicaCancelamento String?  @db.Text
  aceitaPets           Boolean  @default(false)
  aceitaCriancas       Boolean  @default(true)
  formasPagamento      String[]
  observacoes          String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  comercio Comercio @relation(fields: [comercioId], references: [id], onDelete: Cascade)

  @@map("hospedagem_perfis")
}

// Tipo de quarto/acomodação de um negócio de hospedagem (N:1 com Comercio).
// precoNoite null → "Consultar valores" na vitrine. comodidades é um
// subconjunto do catálogo, específicas do quarto. fotos: URLs no bucket comercios.
model TipoQuarto {
  id          String   @id @default(cuid())
  comercioId  String
  nome        String
  descricao   String?  @db.Text
  precoNoite  Float?
  capacidade  Int?
  camas       String?
  tamanhoM2   Float?
  comodidades String[]
  fotos       String[]
  ordem       Int      @default(0)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  comercio Comercio @relation(fields: [comercioId], references: [id], onDelete: Cascade)

  @@map("tipos_quarto")
}

model Subcategoria {
  id        String    @id @default(cuid())
  nome      String
  categoria Categoria
  ativo     Boolean   @default(true)
  ordem     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  comercios Comercio[]

  @@unique([nome, categoria])
  @@map("subcategorias")
}

model Tag {
  id         String   @id @default(cuid())
  nome       String
  comercioId String
  createdAt  DateTime @default(now())

  comercio Comercio @relation(fields: [comercioId], references: [id], onDelete: Cascade)

  @@unique([nome, comercioId])
  @@map("tags")
}

model Foto {
  id         String   @id @default(cuid())
  url        String
  alt        String?
  ordem      Int      @default(0)
  comercioId String
  createdAt  DateTime @default(now())

  comercio Comercio @relation(fields: [comercioId], references: [id], onDelete: Cascade)

  @@map("fotos")
}

model Produto {
  id                  String      @id @default(cuid())
  tipo                TipoProduto @default(PRODUTO)
  titulo              String
  descricao           String?     @db.Text
  preco               Float?
  imagens             String[]
  disponivel          Boolean     @default(true)
  destaque            Boolean     @default(false)
  precoPromo          Float?
  promoFim            DateTime?
  ordem               Int         @default(0)
  comercioId          String
  categoriaCardapioId String?
  categoriaCatalogoId String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  comercio          Comercio           @relation(fields: [comercioId], references: [id], onDelete: Cascade)
  categoriaCardapio CardapioCategoria? @relation(fields: [categoriaCardapioId], references: [id], onDelete: SetNull)
  categoriaCatalogo CatalogoCategoria? @relation(fields: [categoriaCatalogoId], references: [id], onDelete: SetNull)
  variacoes         CardapioVariacao[]

  @@map("produtos")
}

model CardapioCategoria {
  id         String    @id @default(cuid())
  nome       String
  ordem      Int       @default(0)
  comercioId String
  comercio   Comercio  @relation(fields: [comercioId], references: [id], onDelete: Cascade)
  produtos   Produto[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("cardapio_categorias")
}

// Categorias do catálogo (produtos/serviços fora do cardápio). Espelha
// CardapioCategoria, mas com `tipo` — uma categoria pertence a PRODUTO ou
// SERVICO, nunca aos dois (as abas do catálogo são separadas). Atribuição é
// opcional: itens sem categoria caem no bloco "Outros". onDelete: SetNull no
// Produto faz o item voltar para "Outros" quando a categoria é excluída.
model CatalogoCategoria {
  id         String      @id @default(cuid())
  nome       String
  tipo       TipoProduto
  ordem      Int         @default(0)
  comercioId String
  comercio   Comercio    @relation(fields: [comercioId], references: [id], onDelete: Cascade)
  produtos   Produto[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@map("catalogo_categorias")
}

model CardapioVariacao {
  id        String  @id @default(cuid())
  nome      String
  preco     Float
  ordem     Int     @default(0)
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@map("cardapio_variacoes")
}

model PontoTuristico {
  id                String         @id @default(cuid())
  nome              String
  slug              String         @unique
  descricao         String?        @db.Text
  categoria         CategoriaPonto
  fotos             String[]
  lat               Float?
  lng               Float?
  cep               String?
  endereco          String?
  numero            String?
  bairro            String?
  cidade            String?
  estado            String?
  dicas             String?        @db.Text
  dificuldade       Dificuldade?
  distanciaKm       Float?
  duracaoMin        Int?
  altitudeM         Int?
  temPiscinaNatural Boolean?
  precisaGuia       Boolean?
  periodo           String?
  ativo             Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("pontos_turisticos")
}

// Eventos de analytics — brutos, anônimos (sem PII; visitorId é um UUID de
// sessão). Na escala atual, agregação direto na query resolve; rollup diário
// só se o volume um dia exigir.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  comercioId String
  tipo       String // view | click_whatsapp | click_ligar | click_instagram | click_site | click_rota | click_share | cardapio_view | catalogo_view | item_view | evento_view | galeria_view
  origem     String? // home_destaque | home_abertos | home_eventos | listagem | mapa | busca | qr | google | direto
  meta       Json?
  visitorId  String?
  createdAt  DateTime @default(now())

  comercio Comercio @relation(fields: [comercioId], references: [id], onDelete: Cascade)

  @@index([comercioId, createdAt])
  @@index([comercioId, tipo, createdAt])
  @@map("analytics_events")
}

model Evento {
  id          String    @id @default(cuid())
  titulo      String
  descricao   String?   @db.Text
  dataInicio  DateTime
  dataFim     DateTime?
  imagem      String?
  local       String?
  preco       Float?
  linkExterno String?
  comercioId  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  comercio Comercio @relation(fields: [comercioId], references: [id], onDelete: Cascade)

  @@map("eventos")
}

// Pedido online feito a partir do cardápio. Cliente não tem login — o acesso ao
// acompanhamento é pelo `token` (cuid não-adivinhável) em /pedido/[token].
// Itens são SNAPSHOT (ver PedidoItem): preço/título congelados na compra, sem
// FK forte para Produto. `numero` é sequencial por comércio (via PedidoConfig).
model Pedido {
  id          String       @id @default(cuid())
  token       String       @unique @default(cuid())
  numero      Int
  comercioId  String
  status      PedidoStatus @default(AGUARDANDO)
  tipoEntrega TipoEntrega

  clienteNome  String
  clienteWhats String

  // endereço (só ENTREGA — snapshot textual; numeroEnd evita colidir com `numero`)
  cep         String?
  endereco    String?
  numeroEnd   String?
  bairro      String?
  complemento String?
  referencia  String?

  formaPagamento String // key de FORMAS_PAGAMENTO (src/lib/hospedagem.ts) ou "multiplas"; o detalhe está em PedidoPagamento
  trocoPara      Decimal? @db.Decimal(10, 2) // só quando formaPagamento = "dinheiro"
  observacoes    String?  @db.Text

  // Valores em Decimal(10,2) (Fase 3): somas de caixa exatas. Converter na borda com src/lib/dinheiro.ts.
  subtotal    Decimal @db.Decimal(10, 2) // recalculado no servidor
  taxaEntrega Decimal @default(0) @db.Decimal(10, 2) // 0 em RETIRADA
  total       Decimal @db.Decimal(10, 2)

  // PDV: total = subtotal - desconto + taxaServico + taxaEntrega. subtotal já vem
  // líquido dos descontos por item. Percentuais guardados para recalcular a
  // comanda quando os itens mudam (null = valor fixo / não cobra serviço).
  desconto           Decimal  @default(0) @db.Decimal(10, 2)
  descontoPercentual Decimal? @db.Decimal(5, 2)
  taxaServico        Decimal  @default(0) @db.Decimal(10, 2)
  servicoPercentual  Decimal? @db.Decimal(5, 2)

  // Comanda (origem COMANDA): identificação livre da mesa e plano de divisão da
  // conta salvo pelo PDV (modo, pessoas e itens de cada uma).
  mesa        String? // snapshot do nome da mesa (identificação livre continua valendo)
  mesaId      String? // mesa cadastrada, quando a comanda veio do QR ou foi aberta por uma do cadastro
  divisao     Json?
  // Quando a venda foi encerrada: concluída (ou recusada/cancelada sem ter sido
  // concluída). É a data dos relatórios — cancelar venda concluída não a altera.
  fechadaEm   DateTime?
  juntadaEmId String? // comanda que absorveu esta (status CANCELADO)

  motivoCancelamento String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  origem        OrigemPedido @default(ONLINE)
  // Venda manual: quem registrou (snapshot do nome, como no histórico).
  criadoPorId   String?
  criadoPorNome String?

  // Cliente da loja (Fase 2 do módulo de gestão). O snapshot clienteNome/clienteWhats
  // acima continua sendo a verdade do pedido — o cliente pode ser editado ou excluído.
  clienteId String?

  comercio   Comercio          @relation(fields: [comercioId], references: [id], onDelete: Cascade)
  cliente    Cliente?          @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  mesaRef    Mesa?             @relation(fields: [mesaId], references: [id], onDelete: SetNull)
  itens      PedidoItem[]
  historico  PedidoHistorico[]
  pagamentos PedidoPagamento[]

  @@unique([comercioId, numero])
  @@index([comercioId, status, createdAt])
  @@index([clienteId, createdAt])
  @@index([comercioId, origem, createdAt])
  @@index([comercioId, fechadaEm])
  @@map("pedidos")
}

// Cliente de UMA loja (docs/modulo-gestao.md, Fase 2). Nunca da plataforma: o mesmo
// WhatsApp em duas lojas são dois Clientes sem ligação, nem para o dono de várias
// lojas. Sem agregados guardados — totais saem dos pedidos em SQL (decisão 2026-09-13).
// Criado no checkout (src/lib/gestao/clientes.ts) ou manualmente (cliente de balcão).
model Cliente {
  id          String    @id @default(cuid())
  comercioId  String
  nome        String
  whatsapp    String? // só dígitos com DDD, sem o 55; null = balcão sem WhatsApp
  email       String?
  aniversario DateTime? @db.Date
  observacoes String?   @db.Text
  tags        String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  comercio Comercio @relation(fields: [comercioId], references: [id], onDelete: Cascade)
  pedidos  Pedido[]

  @@unique([comercioId, whatsapp]) // Postgres aceita vários null
  @@index([comercioId, nome])
  @@map("clientes")
}

enum AcaoDadosCliente {
  LISTA
  DETALHE
  CADASTRO
  EDICAO
  EXCLUSAO
}

// Registro de acesso do ADMIN do guia a dados de clientes de uma loja (LGPD — o
// admin entra pelo "gerenciar"). Só inserção. Guarda o clienteId, nunca o nome:
// depois de uma exclusão, o registro não pode reintroduzir o dado apagado.
// Visível para o dono na tela de Clientes e para o admin na edição do comércio.
model AcessoDadosCliente {
  id         String           @id @default(cuid())
  comercioId String
  adminId    String // referência fraca (sem FK)
  adminNome  String? // snapshot
  acao       AcaoDadosCliente
  clienteId  String? // referência fraca; cliente pode ter sido excluído
  createdAt  DateTime         @default(now())

  comercio Comercio @relation(fields: [comercioId], references: [id], onDelete: Cascade)

  @@index([comercioId, createdAt])
  @@map("acessos_dados_cliente")
}

// Linha do tempo do pedido: um registro por mudança de status, gravado na MESMA
// transação da mudança (src/lib/pedidos-historico.ts). `autorNome` é snapshot —
// o membro pode ser removido depois (e a conta apagada) sem o histórico perder o
// autor; por isso `userId` é referência fraca, sem FK. Nome de funcionário nunca
// vai para o cliente: a página pública só recebe status + horário.
model PedidoHistorico {
  id        String          @id @default(cuid())
  pedidoId  String
  status    PedidoStatus // status que o pedido passou a ter
  origem    OrigemHistorico
  userId    String? // referência fraca (sem FK)
  autorNome String? // snapshot do nome no momento da ação
  motivo    String? // recusa/cancelamento
  descricao String? // evento sem troca de status (comanda: item lançado, pagamento, transferência)
  createdAt DateTime        @default(now())

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId, createdAt])
  @@map("pedido_historicos")
}

model PedidoItem {
  id           String  @id @default(cuid())
  pedidoId     String
  produtoId    String? // referência fraca (sem FK forte) — só rastreio
  titulo       String // snapshot
  variacaoNome String? // snapshot da variação escolhida
  precoUnit    Decimal @db.Decimal(10, 2) // snapshot do preço unitário
  quantidade   Int
  observacao   String?
  desconto     Decimal @default(0) @db.Decimal(10, 2) // desconto na linha (valor)

  // Comanda: rodada de envio para a produção (null = ainda não enviado).
  rodada    Int?
  enviadoEm DateTime?
  prontoEm  DateTime?
  createdAt DateTime  @default(now())

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@map("pedido_itens")
}

// Pagamentos de um pedido (PDV): várias formas na mesma venda, divisão da conta
// entre pessoas e pagamento parcial de comanda. Fonte única dos relatórios por
// forma de pagamento — o checkout online grava um pagamento com o total.
model PedidoPagamento {
  id               String    @id @default(cuid())
  pedidoId         String
  comercioId       String
  forma            String // key de FORMAS_PAGAMENTO
  valor            Decimal   @db.Decimal(10, 2) // quanto abate da conta
  recebido         Decimal?  @db.Decimal(10, 2) // dinheiro entregue (troco = recebido - valor)
  pagante          String? // "Pessoa 1", "Ana" — divisão da conta
  userId           String?
  autorNome        String?
  estornadoEm      DateTime?
  estornadoPorNome String?
  motivoEstorno    String?
  createdAt        DateTime  @default(now())

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@index([comercioId, createdAt])
  @@map("pedido_pagamentos")
}

// Mesa do salão com QR Code próprio (docs/gestao-ideias.md 5.2). O QR é fixo e
// leva para /mesa/[token]: o cliente vê a conta da mesa, chama o garçom e pede.
model Mesa {
  id         String   @id @default(cuid())
  comercioId String
  nome       String // "4", "Varanda 2" — o que vai impresso no QR
  area       String? // "Salão", "Varanda", "Deck"
  token      String   @unique // segredo do QR (não é o id: pode ser trocado sem perder a mesa)
  ativa      Boolean  @default(true)
  ordem      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  comercio Comercio      @relation(fields: [comercioId], references: [id], onDelete: Cascade)
  pedidos  Pedido[]
  chamados ChamadoMesa[]

  @@unique([comercioId, nome])
  @@index([comercioId, ordem])
  @@map("mesas")
}

// "Chame o garçom" e "peça a conta" feitos pelo cliente na página da mesa.
model ChamadoMesa {
  id              String      @id @default(cuid())
  comercioId      String
  mesaId          String
  pedidoId        String? // comanda aberta no momento do chamado (referência fraca)
  tipo            TipoChamado
  observacao      String?
  atendidoEm      DateTime?
  atendidoPorNome String?
  createdAt       DateTime    @default(now())

  comercio Comercio @relation(fields: [comercioId], references: [id], onDelete: Cascade)
  mesa     Mesa     @relation(fields: [mesaId], references: [id], onDelete: Cascade)

  @@index([comercioId, atendidoEm, createdAt])
  @@map("chamados_mesa")
}

// Config de pedidos do comércio (1:1, criado sob demanda — mesmo padrão de
// HospedagemPerfil). aceitaPedidos liga/desliga independente de aberto/fechado.
// proximoNumero é o contador de `numero`, incrementado em transação ao criar.
model PedidoConfig {
  id              String   @id @default(cuid())
  comercioId      String   @unique
  aceitaPedidos   Boolean  @default(false)
  entregaAtiva    Boolean  @default(true)
  retiradaAtiva   Boolean  @default(true)
  pedidoMinimo    Decimal  @default(0) @db.Decimal(10, 2)
  tempoPreparoMin Int?
  formasPagamento String[]
  proximoNumero   Int      @default(1)
  taxaServicoPct  Decimal? @db.Decimal(5, 2) // PDV: taxa de serviço sugerida (null = desligada)

  // QR na mesa: o que o cliente pode fazer na página pública da mesa
  mesaQrAbrirConta   Boolean  @default(true) // abrir a comanda quando a mesa está livre
  mesaQrPedido       Boolean  @default(true) // pedir itens (sempre com aprovação do garçom)
  mesaQrChamarGarcom Boolean  @default(true)
  mesaQrPedirConta   Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  comercio Comercio @relation(fields: [comercioId], references: [id], onDelete: Cascade)

  @@map("pedido_configs")
}

// Inscrição de Web Push de um dispositivo do comerciante (navegador). Um
// comerciante pode ter vários aparelhos. endpoint é único (a chave da
// inscrição no browser). Removida quando o push retorna 404/410 (expirada).
model PushSubscription {
  id         String   @id @default(cuid())
  comercioId String
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  comercio Comercio @relation(fields: [comercioId], references: [id], onDelete: Cascade)

  @@index([comercioId])
  @@map("push_subscriptions")
}

// Catálogo canônico de bairros/áreas de entrega da cidade (e cidades vizinhas).
// Populado por seed e gerenciado pelo admin. `cidade`/`uf` permitem contemplar
// cidades vizinhas (ex.: Gonçalves/MG). É a lista que o comerciante seleciona.
// Futuro multitenant: ganha `cityId` na Fase 0 (ver docs/multitenant.md) — o
// `cityId` será o TENANT dono do catálogo, distinto de `cidade` (onde a área fica).
model Bairro {
  id     String  @id @default(cuid())
  nome   String
  cidade String
  uf     String
  ativo  Boolean @default(true)
  ordem  Int     @default(0)

  zonas ZonaEntrega[]

  @@unique([nome, cidade])
  @@map("bairros")
}

// Área de entrega de UMA loja, com a taxa dela. Pode apontar para um Bairro do
// catálogo (`bairroId`) ou ser uma área CUSTOM privada da loja (`bairroId` null).
// `nome`/`cidade`/`uf` são denormalizados (copiados do catálogo ou digitados) —
// o checkout e o snapshot do pedido leem direto daqui, sem depender do catálogo.
model ZonaEntrega {
  id         String   @id @default(cuid())
  comercioId String
  bairroId   String? // catálogo (rastreio); null = custom da loja
  nome       String
  cidade     String
  uf         String
  taxa       Decimal  @db.Decimal(10, 2)
  ativo      Boolean  @default(true)
  ordem      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  comercio Comercio @relation(fields: [comercioId], references: [id], onDelete: Cascade)
  bairro   Bairro?  @relation(fields: [bairroId], references: [id], onDelete: SetNull)

  @@index([comercioId])
  @@map("zonas_entrega")
}
